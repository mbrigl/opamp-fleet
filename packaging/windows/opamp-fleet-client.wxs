<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer (ADR-0046).

  The package delivers one file and then calls the Client's own `service install` (ADR-0010) — it
  registers no service of its own. An MSI `ServiceInstall` element would write a registration
  knowing nothing of ADR-0030's service name and display name, nor of ADR-0020's SCM recovery
  actions, both of which `service install` sets through calls the `service-manager` backend cannot
  make. There is one install path on four operating systems and this is not a second one.

  Built by `wix build` with the UI extension; `Version` and `BinaryPath` come in as -d arguments
  from the release workflow, so the version in the MSI is the one the binary reports (ADR-0026).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="OpAMP Fleet Client"
           Manufacturer="OpAMP Fleet"
           Version="$(Version)"
           Language="1033"
           Codepage="1252"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500"
           UpgradeCode="0CC090C9-169E-493A-B497-760713C83DDC">

    <!--
      The UpgradeCode above is the product's permanent identity: it is how Windows Installer knows
      1.2.4 is an upgrade of 1.2.3 rather than a second product beside it. NEVER change it. A new
      GUID here strands every host that already carries the old one — they would keep the old
      version installed forever and gain a duplicate entry in Add/Remove Programs. The ProductCode
      is deliberately left to be generated per build, which is what MajorUpgrade requires.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first to install this one." />

    <MediaTemplate EmbedCab="yes" />

    <SummaryInformation Description="OpAMP Fleet Client — places a machine under OpAMP management" />

    <!--
      Both answers the dialogs collect are public properties (all uppercase) and Secure, and neither
      is cosmetic:

        * public, because Windows Installer resets private properties when execution crosses from
          the UI sequence into the execute sequence — a value typed into a dialog would never reach
          the custom action below;
        * Secure, because that is what lets an administrator set the same two on the command line,
          which is how Intune, Group Policy and SCCM will deploy this:

              msiexec /i opamp-fleet-client_1.2.3_windows_amd64.msi /qn ^
                INSTALLFOLDER="C:\Program Files\OpAMP Fleet Client" ^
                ENDPOINT="wss://fleet.example.com/v1/opamp"

      ENDPOINT has no default on purpose: an empty one is a legal answer meaning "configure later",
      and it selects the second custom action below.
    -->
    <Property Id="ENDPOINT" Secure="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" Secure="yes" />

    <!--
      One directory for everything (ADR-0046 clause 5): the .exe, the client.toml the install
      writes, and ADR-0010's versions/, current and state/ all live under INSTALLFOLDER, because
      the root flag of `service install` already anchors all of them. The operator configures one
      path, not half of one.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpAMP Fleet Client" />
    </StandardDirectory>

    <ComponentGroup Id="ClientFiles" Directory="INSTALLFOLDER">
      <Component Id="ClientExe">
        <File Id="OpampFleetClientExe"
              Name="opamp-fleet-client.exe"
              Source="$(BinaryPath)"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="OpAMP Fleet Client" Level="1">
      <ComponentGroupRef Id="ClientFiles" />
    </Feature>

    <!--
      WelcomeDlg → InstallDirDlg → EndpointDlg → VerifyReadyDlg (WixUI_OpampInstallDir.wxs).
      A plain UIRef rather than `ui:WixUI`: that element names one of the toolset's built-in sets,
      and this set is ours.
    -->
    <UIRef Id="WixUI_OpampInstallDir" />

    <!--
      Registering the service, deferred and without impersonation: it writes under Program Files and
      talks to the SCM, and neither is something the invoking user may be able to do. A type 18
      custom action takes a command line that "commonly contains properties that are designated
      dynamically" — the Target is a formatted field resolved when the installation script is
      written, so INSTALLFOLDER and ENDPOINT arrive without a CustomActionData round trip.

      Two actions rather than one condition inside a command line, because an empty endpoint flag
      is not the same request as no endpoint flag at all: the first would be rejected by the
      loader's own endpoint rule, the second is the ordinary "configure it later" install that
      only warns.
    -->
    <CustomAction Id="RegisterServiceWithEndpoint"
                  FileRef="OpampFleetClientExe"
                  ExeCommand="service install --root &quot;[INSTALLFOLDER]&quot; --endpoint &quot;[ENDPOINT]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="RegisterService"
                  FileRef="OpampFleetClientExe"
                  ExeCommand="service install --root &quot;[INSTALLFOLDER]&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      The mirror, and best-effort by design (`Return="ignore"`): a host whose service was already
      unregistered by hand must still be able to uninstall. Sequenced before RemoveFiles, because a
      type 18 action needs its executable to still be on disk.

      `service uninstall` leaves the install root and the state directory behind, as it does
      everywhere (ADR-0010) — deleting a client.toml holding a credential the operator typed would
      be the overwrite ADR-0027 refused, one step later.
    -->
    <CustomAction Id="StopService"
                  FileRef="OpampFleetClientExe"
                  ExeCommand="service stop"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="UnregisterService"
                  FileRef="OpampFleetClientExe"
                  ExeCommand="service uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!--
        After InstallFiles: the executable these actions run is the one this package just laid down,
        so it has to exist first.

        The service is registered and left stopped, exactly as the `.deb` and `.rpm` post-install
        does and for the same reason (ADR-0046 clause 3, ADR-0027): a Client with no configuration
        dials the development default and manages nothing, and an installer must not manufacture
        that state on every host it touches. An install that was given an ENDPOINT still does not
        start — the credential, if the Server needs one, is not in yet.
      -->
      <Custom Action="RegisterServiceWithEndpoint" After="InstallFiles"
              Condition="NOT REMOVE AND ENDPOINT&lt;&gt;&quot;&quot;" />
      <Custom Action="RegisterService" After="RegisterServiceWithEndpoint"
              Condition="NOT REMOVE AND ENDPOINT=&quot;&quot;" />

      <!-- Only a real uninstall. On a major upgrade the new package re-registers straight after. -->
      <Custom Action="StopService" Before="UnregisterService"
              Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnregisterService" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
