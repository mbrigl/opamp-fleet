{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Server",
      "cargo": {
        "args": ["build", "--bin", "server", "--package", "server"],
        "filter": { "name": "server", "kind": "bin" }
      },
      "args": ["--config", "config/server.toml"],
      "cwd": "${workspaceFolder}"
    },
    {
      // The package is `supervisor`, the binary it produces is `supervisor` (ADR-0028):
      // `--package` takes the first, `--bin` and the filter take the second.
      "type": "lldb",
      "request": "launch",
      "name": "Supervisor",
      "cargo": {
        "args": ["build", "--bin", "supervisor", "--package", "client"],
        "filter": { "name": "supervisor", "kind": "bin" }
      },
      "args": ["--config", "config/supervisor.toml"],
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Server + Supervisor",
      "configurations": ["Server", "Supervisor"],
      "stopAll": true
    }
  ]
}
