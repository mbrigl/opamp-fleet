{
  "name": "OpAMP Fleet DevContainer",

  // A Compose project rather than a bare image, so the development observability stack comes up
  // with the container and is reachable from inside it — the Collector on `localhost:4318`, Grafana
  // on `grafana:3000`, ClickHouse on `clickhouse:9000`. The base image pin, the workspace mount and
  // the published Agent-plane port live in `docker-compose.yml`, which is where a Compose-based Dev
  // Container reads them from; the reasoning sits there with them. Still no host Docker socket
  // (ADR-0002): the compose runs on the host, before VS Code attaches.
  //
  // One file, not two. The stack used to live in `deploy/observability/` and be merged in as a
  // second compose file so it could also run standalone; it is now part of this directory and this
  // project, so `otel-collector` states its workspace network namespace directly instead of
  // overriding an imported service. See `OBSERVABILITY.md` for what the three services are for.
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  // The services started alongside `workspace`, which is always started. Drop an entry to keep it
  // out of the next start — from inside the container there is no daemon to start it by hand, so
  // this list is the on/off switch. All three together want roughly 2 GB beyond the toolchain.
  "runServices": ["clickhouse", "otel-collector", "grafana"],
  "workspaceFolder": "/workspace",

  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  // The host's agent config directory. HOME is set on Linux and macOS, USERPROFILE on Windows;
  // exactly one of the two is non-empty, so concatenating both yields the home directory on every
  // host (the pattern the Dev Containers documentation recommends).
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/vscode/.claude,type=bind"
  ],

  // `stopCompose`, not `stopContainer`: a Compose-based Dev Container takes the whole project down
  // together, so the observability containers do not outlive the window that started them.
  "shutdownAction": "stopCompose",

  // Runs on the host before the container is created. Ensures the bind-mount source for the agent
  // config exists, so Docker does not auto-create it as a root-owned directory (which breaks
  // credential writes inside the container). Written to work in both a POSIX shell and cmd.exe:
  // plain `mkdir` (cmd.exe knows no `-p`; the parent is the home directory and always exists) and
  // `|| exit 0` so an already existing directory — an error for both shells — does not abort the
  // container build.
  "initializeCommand": "mkdir \"${localEnv:HOME}${localEnv:USERPROFILE}/.claude\" || exit 0",

  // Runs inside the container once it is created. Git does not version its hooks, so the
  // repository keeps them under .githooks/ and this points git at them: pre-commit refuses a
  // commit on main, pre-push runs the checks first (AGENTS.md §5 and §6). Outside the container,

  // DevContainer Features layered on top of the base image. The container intentionally has NO
  // access to the host Docker daemon (no socket mount) — see ADR-0002. Manage the host's containers
  // from a host-side VS Code extension instead (README → "Host container management").
  "features": {
    // GitHub CLI (`gh`) — used by the coding agent for GitHub operations and as the git
    // credential helper. Git writes still require explicit human approval (see AGENTS.md §6).
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Rust stable toolchain (rustup + cargo, with rustfmt & clippy) — the project's language
    // toolchain (ADR-0009). The build chain needs no system protoc (ADR-0010 uses the
    // pure-Rust protox), so no extra system packages are required here.
    "ghcr.io/devcontainers/features/rust:1": {}
  },

  //
  // The one below is *developer tooling* — nothing shipped depends on it, which is why it does
  // not need an ADR (AGENTS.md §3.6) — and it earns its place:
  //
  "postCreateCommand": "git config core.hooksPath .githooks && sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends llvm",
  "customizations": {
    // VS Code extensions installed inside the container
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "mistralai.mistral-vibe-code",
        "ms-vscode-remote.remote-containers",
        // Rust development: language server, debugger, and Cargo.toml support.
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml"
      ]
    }
  },

  // The Server's two planes (ADR-0012), published the way each one is meant to be reached.
  //
  // The Agent plane (4320, OpAMP + package downloads) is where the fleet connects, so Docker
  // publishes it itself (`ports:` on the `workspace` service) and the Server is reachable from the
  // host network under the host's own IP — not just from the host via localhost. VS Code's
  // `forwardPorts` would bind the host side to 127.0.0.1 only; do not add 4320 to it, the two
  // mechanisms fight over the same host port.
  //
  // The Operator plane (4321, REST API + UI) binds loopback *inside* the container by default,
  // which Docker cannot publish — so it goes through `forwardPorts`, which tunnels into the
  // container and reaches a loopback listener. That is also the right exposure for it: the
  // developer, not the network.
  "forwardPorts": [4321],
  "portsAttributes": {
    "4320": { "label": "Fleet Server (OpAMP + downloads)" },
    "4321": { "label": "Fleet Server (Control plane: REST + UI)" },
    // The Collector listens in this container's network namespace, so VS Code sees its sockets and
    // would offer to forward ports Docker already publishes from the same service. Labelled for
    // the Ports view, ignored by the auto-forwarder.
    "4317": { "label": "OTLP/gRPC → Collector", "onAutoForward": "ignore" },
    "4318": { "label": "OTLP/HTTP → Collector", "onAutoForward": "ignore" },
    "8888": { "label": "Collector self-metrics", "onAutoForward": "ignore" },
    "13133": { "label": "Collector health", "onAutoForward": "ignore" }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
