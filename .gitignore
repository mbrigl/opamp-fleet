# Dev Container
.devcontainer/devcontainer-lock.json

# Build artifacts
/dist/
/build/
/target/

# Local runtime state (default paths of server.toml / supervisor.toml).
#
# Deliberately *not* anchored to the repository root: these are relative defaults, so they are
# created under whatever directory the process runs in — and `cargo test` runs a crate's unit tests
# with its package directory as the working directory, which puts `crates/client/client-state/` in
# the tree. Anchored patterns left those untracked and waiting to be committed by accident.
fleet-configs/
client-state/
# Package artifacts are programs — hundreds of megabytes each; they belong in a store, never in
# the repository (ADR-0015).
fleet-packages/

# Environment files
/.env
/.env.local
/.env.*.local

# OS / editor
.DS_Store
Thumbs.db
